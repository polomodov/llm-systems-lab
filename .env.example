# Set only the selected provider key. Real values belong only in .env.
# Claude Code, OpenCode, Pi, mini-SWE-agent, OpenHands (Anthropic)
ANTHROPIC_API_KEY=
# Pi, mini-SWE-agent, OpenHands (OpenAI)
OPENAI_API_KEY=
# Codex exec uses its own environment variable name
CODEX_API_KEY=
# Antigravity CLI: direct Gemini API
GEMINI_API_KEY=
# GitHub Copilot CLI: a token with Copilot access
COPILOT_GITHUB_TOKEN=
# Amp
AMP_API_KEY=
