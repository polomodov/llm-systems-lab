# Заполните только ключ выбранного провайдера. Реальные значения — только в .env.
# Claude Code, OpenCode, Pi, mini-SWE-agent, OpenHands (Anthropic)
ANTHROPIC_API_KEY=
# Pi, mini-SWE-agent, OpenHands (OpenAI)
OPENAI_API_KEY=
# Codex exec использует собственное имя переменной
CODEX_API_KEY=
# Antigravity CLI: direct Gemini API
GEMINI_API_KEY=
# GitHub Copilot CLI: токен с доступом к Copilot
COPILOT_GITHUB_TOKEN=
# Amp
AMP_API_KEY=
